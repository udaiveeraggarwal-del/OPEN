# Required for Telegram bot access: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=8934206861:AAGzmumef_5UDfrzb87eM0nfPMbeW70iYnw

# Required for auto-saving all generated code & workspace to private GitHub repository
GITHUB_TOKEN=github_pat_your_fine_grained_pat_here

# Private repository to sync with (default: udaiveeraggarwal-del/OPENCLAW-CLOUD-)
